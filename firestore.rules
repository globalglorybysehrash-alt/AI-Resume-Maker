rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Catch-All Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Reusable Hardened Security Primitives
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 3. User Profile Validation Helper
    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'email', 'createdAt'])
        && data.keys().hasOnly(['id', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.email is string && data.email.size() > 0 && data.email.size() <= 256
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 150))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024))
        && data.createdAt is string && data.createdAt.size() <= 64
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // 4. Saved Resume Validation Helper
    function isValidResume(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'formData', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'title', 'versionLabel', 'versionNumber', 'baseId', 'formData', 'generatedResult', 'createdAt', 'updatedAt'])
        && data.id is string && isValidId(data.id)
        && data.userId is string && data.userId == request.auth.uid
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && (!('versionLabel' in data) || (data.versionLabel is string && data.versionLabel.size() <= 100))
        && (!('versionNumber' in data) || (data.versionNumber is int && data.versionNumber >= 1))
        && (!('baseId' in data) || (data.baseId is string && data.baseId.size() <= 128))
        && data.formData is map
        && (!('generatedResult' in data) || data.generatedResult is map)
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    // 5. User Collection: Strict PII Isolation
    match /users/{userId} {
      // Single doc read restricted strictly to the user themselves
      allow get: if isOwner(userId) && isValidId(userId);
      // Deny bulk listing of user profiles to prevent data harvesting
      allow list: if false;

      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().id == userId;

      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().id == existing().id
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt;

      allow delete: if isOwner(userId) && isValidId(userId);

      // 6. Subcollection: Saved Resumes (Master Gate Pattern)
      match /resumes/{resumeId} {
        allow get: if isOwner(userId) && isValidId(resumeId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId)
          && isValidId(resumeId)
          && isValidResume(incoming())
          && incoming().id == resumeId
          && incoming().userId == userId;

        allow update: if isOwner(userId)
          && isValidId(resumeId)
          && isValidResume(incoming())
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt;

        allow delete: if isOwner(userId) && isValidId(resumeId);
      }
    }
  }
}
